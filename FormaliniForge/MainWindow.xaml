<Window x:Class="FormaliniForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Formalini Forge — Studio" Icon="Assets/FormaliniForge.ico" Width="1600" Height="950" PreviewKeyDown="Window_PreviewKeyDown"
        MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen"
        Background="#111827" Foreground="#E5EAF2"
        FontFamily="Segoe UI" FontSize="13">
 <Window.Resources>
  <SolidColorBrush x:Key="Surface" Color="#172033"/>
  <SolidColorBrush x:Key="SurfaceRaised" Color="#202C40"/>
  <SolidColorBrush x:Key="Edge" Color="#344258"/>
  <SolidColorBrush x:Key="Accent" Color="#3B82F6"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#25344B"/>
   <Setter Property="Foreground" Value="#E5EAF2"/>
   <Setter Property="BorderBrush" Value="#344258"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="11,6"/>
   <Setter Property="Margin" Value="2"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#345179"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#1D4ED8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Background" Value="#263448"/><Setter Property="Foreground" Value="#8EA2BC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#2563EB"/>
   <Setter Property="BorderBrush" Value="#3B82F6"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#101827"/>
   <Setter Property="Foreground" Value="#E5EAF2"/>
   <Setter Property="BorderBrush" Value="#3A4B64"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="7,5"/>
   <Setter Property="Margin" Value="0,3,0,7"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Background" Value="#F4F7FC"/>
   <Setter Property="Foreground" Value="#102039"/>
   <Setter Property="Margin" Value="0,3,0,7"/>
   <Setter Property="MinHeight" Value="29"/>
  </Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#172033"/><Setter Property="Foreground" Value="#E5EAF2"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#E5EAF2"/><Setter Property="Padding" Value="7,4"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#344B6C"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TreeView"><Setter Property="Background" Value="#172033"/><Setter Property="Foreground" Value="#E5EAF2"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TreeViewItem"><Setter Property="Foreground" Value="#E5EAF2"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#344B6C"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#152238"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#CFE2FF"/><Setter Property="Foreground" Value="#102039"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
  <Style TargetType="MenuItem"><Setter Property="Foreground" Value="#E5EAF2"/><Setter Property="Background" Value="#172033"/><Style.Triggers><Trigger Property="Role" Value="SubmenuItem"><Setter Property="Background" Value="#F4F7FC"/><Setter Property="Foreground" Value="#102039"/></Trigger><Trigger Property="Role" Value="SubmenuHeader"><Setter Property="Background" Value="#F4F7FC"/><Setter Property="Foreground" Value="#102039"/></Trigger><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#DCEBFF"/><Setter Property="Foreground" Value="#102039"/></Trigger><Trigger Property="IsSubmenuOpen" Value="True"><Setter Property="Foreground" Value="#102039"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="#172033"/><Setter Property="Foreground" Value="#E5EAF2"/><Setter Property="BorderBrush" Value="#344258"/></Style>
  <Style TargetType="TabItem"><Setter Property="Background" Value="#25344B"/><Setter Property="Foreground" Value="#E5EAF2"/><Setter Property="Padding" Value="13,7"/><Setter Property="BorderBrush" Value="#344258"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#DCEBFF"/><Setter Property="Foreground" Value="#102039"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#F4F7FC"/><Setter Property="Foreground" Value="#102039"/></Trigger></Style.Triggers></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#9FB3D0"/></Style>
  <Style x:Key="FieldTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="#B8C8DC"/><Setter Property="Margin" Value="0,6,0,0"/></Style>
 </Window.Resources>
 <DockPanel LastChildFill="True">
  <Border DockPanel.Dock="Top" Background="#0C1422" BorderBrush="#26354A" BorderThickness="0,0,0,1">
   <Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="47"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="8,0">
     <TextBlock DockPanel.Dock="Right" Text="WINDOWS APPLICATION STUDIO" Foreground="#7085A3" FontSize="10" VerticalAlignment="Center" Margin="12,0"/>
     <Menu Background="Transparent" Foreground="#E5EAF2" VerticalAlignment="Center">
      <MenuItem Header="Limbă"><MenuItem Header="English" Click="English_Click"/><MenuItem Header="Română" Click="Romanian_Click"/></MenuItem>
      <MenuItem Header="Fișier"><MenuItem Header="Creează din descriere..." Click="QuickStart_Click"/><MenuItem Header="Proiect nou" InputGestureText="Ctrl+N" Click="NewProject_Click"/><MenuItem Header="Fișier nou..." InputGestureText="Ctrl+Shift+N" Click="NewFile_Click"/><MenuItem Header="Deschide proiect" InputGestureText="Ctrl+O" Click="OpenProject_Click"/><Separator/><MenuItem Header="Salvează" InputGestureText="Ctrl+S" Click="Save_Click"/><MenuItem Header="Istoric / Revino" InputGestureText="Ctrl+Shift+H" Click="History_Click"/></MenuItem>
      <MenuItem Header="Editare"><MenuItem Header="Paletă de comenzi" InputGestureText="Ctrl+Shift+P" Click="CommandPalette_Click"/><Separator/><MenuItem Header="Caută în fișier" InputGestureText="Ctrl+F" Click="FocusFind_Click"/><MenuItem Header="Înlocuiește" InputGestureText="Ctrl+H" Click="FocusReplace_Click"/><MenuItem Header="Caută în proiect" InputGestureText="Ctrl+Shift+F" Click="SearchProject_Click"/><MenuItem Header="Formatează documentul" InputGestureText="Shift+Alt+F" Click="FormatDocument_Click"/></MenuItem>
      <MenuItem Header="Construire"><MenuItem x:Name="HybridMenuItem" Header="Adaugă modul C hibrid..." Click="AddHybridModule_Click"/><MenuItem x:Name="BuildMenuItem" Header="Generează EXE" InputGestureText="F6" Click="Build_Click"/><MenuItem Header="Rulează" InputGestureText="F5" Click="Run_Click"/><MenuItem Header="Depanare" InputGestureText="F7" Click="Debug_Click"/><MenuItem Header="Testează" Click="Test_Click"/><MenuItem Header="Dependențe" Click="Dependencies_Click"/></MenuItem>
      <MenuItem Header="Ferestre"><MenuItem Header="Restabilește poziția panourilor" Click="ResetToolLayout_Click"/></MenuItem>
      <MenuItem Header="GitHub"><MenuItem Header="Status / Inițializează" Click="Git_Click"/><MenuItem Header="Conectează repository" Click="ConnectGitHub_Click"/><Separator/><MenuItem Header="Înregistrează modificări" Click="GitCommit_Click"/><MenuItem Header="Trimite modificări" Click="GitPush_Click"/><MenuItem Header="Preia modificări" Click="GitPull_Click"/></MenuItem>
      <MenuItem Header="Extensii"><MenuItem Header="Gestionează extensiile..." Click="ManageExtensions_Click"/></MenuItem>
      <MenuItem Header="Ajutor"><MenuItem Header="Despre Formalini Forge" Click="About_Click"/></MenuItem>
     </Menu>
    </DockPanel>
    <DockPanel Grid.Row="1" Margin="10,0">
     <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
      <Border Background="#2563EB" CornerRadius="5" Width="30" Height="30" Margin="0,0,10,0"><TextBlock Text="F" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel VerticalAlignment="Center" Margin="0,0,15,0"><TextBlock Text="Formalini Forge" FontWeight="Bold" FontSize="15"/><TextBlock Text="DESIGN · COD · COMPILARE" FontSize="9" Foreground="#7C95B5"/></StackPanel>
      <Border Width="1" Background="#344258" Margin="0,8,10,8"/>
      <TextBlock Text="Proiecte · Designer · Cod · Construire" Foreground="#9FB3D0" VerticalAlignment="Center"/>
     </StackPanel>
     <TextBlock x:Name="ProjectLabel" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#9FB3D0" Margin="12,0" Text="Niciun proiect deschis"/>
    </DockPanel>
   </Grid>
  </Border>
  <StatusBar DockPanel.Dock="Bottom" Background="#1857A8" Foreground="White" Height="27" Padding="8,1"><StatusBarItem><TextBlock x:Name="StatusText" Text="Pregătit"/></StatusBarItem><Separator/><StatusBarItem><TextBlock Text="Windows x64"/></StatusBarItem></StatusBar>
   <Grid x:Name="WorkspaceGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="255" MinWidth="180"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="440"/><ColumnDefinition Width="5"/><ColumnDefinition Width="340" MinWidth="270"/></Grid.ColumnDefinitions>
    <Border x:Name="LeftToolHost" Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,1,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="150"/><RowDefinition Height="5"/><RowDefinition Height="265" MinHeight="160"/></Grid.RowDefinitions>
      <DockPanel x:Name="ExplorerPanel" Grid.Row="0">
      <StackPanel DockPanel.Dock="Top" Margin="12,11,12,5">
       <TextBlock Text="EXPLORATOR PROIECT" Style="{StaticResource SectionTitle}"/>
       <TextBlock Text="Fișierele se deschid în taburi" FontSize="11" Foreground="#788DA9" Margin="0,2,0,8"/>
       <TextBlock Text="Fereastră activă" Style="{StaticResource FieldTitle}"/>
       <ComboBox x:Name="WindowBox" SelectionChanged="WindowBox_SelectionChanged"/>
       <Button Content="＋ Fereastră nouă" Click="AddWindow_Click" HorizontalAlignment="Stretch"/>
      </StackPanel>
      <TreeView x:Name="FileTree" Margin="7,0,5,6" SelectedItemChanged="FileTree_SelectedItemChanged"/>
     </DockPanel>
     <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#344258"/>
      <DockPanel x:Name="ToolboxPanel" Grid.Row="2" Margin="8,9,8,8">
      <StackPanel DockPanel.Dock="Top"><TextBlock Text="COMPONENTE" Style="{StaticResource SectionTitle}" Margin="4,0,0,2"/><TextBlock Text="Trage pe formular sau dublu clic" FontSize="11" Foreground="#788DA9" Margin="4,0,0,5"/></StackPanel>
      <ListBox x:Name="Toolbox" MouseDoubleClick="Toolbox_DoubleClick" PreviewMouseMove="Toolbox_PreviewMouseMove"><ListBoxItem Content="Button"/><ListBoxItem Content="Label"/><ListBoxItem Content="TextBlock"/><ListBoxItem Content="TextBox"/><ListBoxItem Content="PasswordBox"/><ListBoxItem Content="RichTextBox"/><ListBoxItem Content="CheckBox"/><ListBoxItem Content="RadioButton"/><ListBoxItem Content="ToggleButton"/><ListBoxItem Content="ComboBox"/><ListBoxItem Content="ListBox"/><ListBoxItem Content="ListView"/><ListBoxItem Content="TreeView"/><ListBoxItem Content="DataGrid"/><ListBoxItem Content="DatePicker"/><ListBoxItem Content="Calendar"/><ListBoxItem Content="Slider"/><ListBoxItem Content="ProgressBar"/><ListBoxItem Content="TabControl"/><ListBoxItem Content="GroupBox"/><ListBoxItem Content="Expander"/><ListBoxItem Content="Border"/><ListBoxItem Content="Rectangle"/><ListBoxItem Content="Ellipse"/></ListBox>
     </DockPanel>
    </Grid>
   </Border>
    <GridSplitter x:Name="LeftToolSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#26354A"/>
   <Grid Grid.Column="2" Background="#111827"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#172033" BorderBrush="#344258" BorderThickness="0,0,0,1" Padding="13,8"><DockPanel><TextBlock Text="SPAȚIU DE LUCRU" Style="{StaticResource SectionTitle}"/><TextBlock DockPanel.Dock="Right" Text="Designer vizual  ·  Editor de cod  ·  Rezultat" Foreground="#788DA9" HorizontalAlignment="Right" FontSize="11"/></DockPanel></Border>
    <TabControl Grid.Row="1" x:Name="MainTabs" Margin="0,0,0,0">
     <TabItem Header="◫ Designer vizual">
      <Grid Background="#202938"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Border Grid.Row="0" Background="#172033" BorderBrush="#344258" BorderThickness="0,0,0,1" Padding="12,7"><TextBlock Text="Suprafața formularului · trage componente din stânga și editează proprietățile din dreapta" FontSize="11" Foreground="#AABCD2"/></Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Border x:Name="DesignerFrame" Width="850" Height="650" Margin="25" HorizontalAlignment="Center" VerticalAlignment="Top" BorderBrush="#475B77" BorderThickness="1" Background="White"><Grid><Grid.RowDefinitions><RowDefinition x:Name="PreviewChromeRow" Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border x:Name="PreviewChrome" Grid.Row="0" Background="#E6EBF2" BorderBrush="#A8B5C6" BorderThickness="0,0,0,1"><DockPanel LastChildFill="True"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Border x:Name="PreviewMinButton" Width="44" BorderBrush="#CAD3DF" BorderThickness="1,0,0,0"><TextBlock Text="─" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#172033"/></Border><Border x:Name="PreviewMaxButton" Width="44" BorderBrush="#CAD3DF" BorderThickness="1,0,0,0"><TextBlock Text="□" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#172033"/></Border><Border x:Name="PreviewCloseButton" Width="44" BorderBrush="#CAD3DF" BorderThickness="1,0,0,0"><TextBlock Text="×" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#172033"/></Border></StackPanel><Image x:Name="PreviewIcon" DockPanel.Dock="Left" Width="17" Height="17" Margin="9,0,7,0" Source="Assets/FormaliniForge.ico"/><TextBlock x:Name="PreviewTitle" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#172033" FontSize="12"/></DockPanel></Border><Canvas Grid.Row="1" x:Name="DesignCanvas" Width="848" Height="616" Background="#F8FAFC" AllowDrop="True" Drop="DesignCanvas_Drop" MouseLeftButtonDown="DesignCanvas_MouseLeftButtonDown" PreviewMouseRightButtonDown="DesignCanvas_PreviewMouseRightButtonDown"/><Thumb x:Name="FormResizeHandle" Grid.RowSpan="2" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Background="#2563EB" BorderBrush="White" BorderThickness="2" ToolTip="Trage pentru a redimensiona formularul" DragStarted="FormResize_DragStarted" DragDelta="FormResize_DragDelta" DragCompleted="FormResize_DragCompleted"/></Grid></Border></ScrollViewer>
      </Grid>
     </TabItem>
     <TabItem Header="Cod">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,6"><TextBox x:Name="FindBox" Width="150" ToolTip="Caută text"/><TextBox x:Name="ReplaceBox" Width="150" Margin="5,3,3,7" ToolTip="Înlocuiește cu"/><Button Content="Găsește" Click="Find_Click"/><Button Content="Înlocuiește" Click="Replace_Click"/><Button Content="Tot" Click="ReplaceAll_Click"/><Button Content="În proiect" Click="SearchProject_Click"/><Button Content="Urmărește la linie" Click="AddWatch_Click" ToolTip="Urmărește o variabilă fără a opri execuția"/><CheckBox x:Name="AutoCodeToggle" Content="Codifică automat cererile" IsChecked="True" VerticalAlignment="Center" Margin="9,0,0,0" ToolTip="Transformă în cod instrucțiunile scrise în metode C# după o pauză de tastare"/></StackPanel>
        <DockPanel Grid.Row="1" Margin="8,0,8,6"><Button DockPanel.Dock="Right" Content="Generează în fișierul deschis" Click="GenerateCode_Click" Style="{StaticResource PrimaryButton}"/><TextBox x:Name="CodeRequestBox" TextWrapping="Wrap" ToolTip="Descrie în cuvinte ce cod vrei în fișierul deschis. Exemplu: afișează Hello World."/></DockPanel>
        <TabControl x:Name="EditorTabs" Grid.Row="2" SelectionChanged="EditorTabs_SelectionChanged"/>
      </Grid>
     </TabItem>
     <TabItem Header="⌁ Construire"><Grid Background="#0C1422"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Background="#172033" Margin="0,0,0,1" LastChildFill="False"><TextBlock x:Name="RunStatus" Text="Pregătit" Margin="12,8" Foreground="#9FB3D0"/><Button DockPanel.Dock="Right" Content="Oprește" Click="StopRun_Click" Margin="6,3"/></DockPanel><Expander Grid.Row="1" Header="Variabile urmărite · valori live" Foreground="#E5EAF2" Background="#172033" IsExpanded="True"><ListBox x:Name="WatchList" Height="82" Background="#101827" Foreground="#C7DCF7" BorderThickness="0"/></Expander><TextBox x:Name="BuildOutput" Grid.Row="2" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0C1422" BorderThickness="0" Padding="15"/></Grid></TabItem>
     <TabItem x:Name="BrowserWorkspaceTab" Header="🌐 Browser"><Grid Background="#0C1422"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Background="#172033" LastChildFill="True" Margin="0,0,0,1"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button x:Name="BrowserBackButton" Content="←" ToolTip="Înapoi" Width="32" Click="BrowserBack_Click"/><Button x:Name="BrowserForwardButton" Content="→" ToolTip="Înainte" Width="32" Click="BrowserForward_Click"/><Button Content="⟳" ToolTip="Reîncarcă" Width="32" Click="BrowserReload_Click"/><Button Content="×" ToolTip="Oprește încărcarea" Width="32" Click="BrowserStop_Click"/><Button Content="⌂" ToolTip="Pagina de pornire" Width="32" Click="BrowserHome_Click"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="+" ToolTip="Tab nou" Width="32" Click="BrowserNewTab_Click"/><Button Content="Sursă" ToolTip="Vezi sursa paginii" Click="BrowserViewSource_Click"/><Button Content="DevTools" ToolTip="Instrumente dezvoltator" Click="BrowserDevTools_Click"/><Menu Background="#172033" VerticalAlignment="Center"><MenuItem Header="⋮" ToolTip="Mai multe acțiuni"><MenuItem Header="Găsește în pagină" Click="BrowserFind_Click"/><Separator/><MenuItem Header="Mărește" Click="BrowserZoomIn_Click"/><MenuItem Header="Micșorează" Click="BrowserZoomOut_Click"/><MenuItem Header="Dimensiune normală" Click="BrowserZoomReset_Click"/><Separator/><MenuItem Header="Printează" Click="BrowserPrint_Click"/><MenuItem Header="Copiază adresa" Click="BrowserCopyAddress_Click"/></MenuItem></Menu><Button Content="↗" ToolTip="Deschide în browser extern" Width="32" Click="BrowserExternal_Click"/></StackPanel><TextBox x:Name="BrowserAddressBox" KeyDown="BrowserAddress_KeyDown" VerticalContentAlignment="Center" Margin="4,3" ToolTip="Adresă web"/></DockPanel><Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="120"/><RowDefinition x:Name="BrowserDevSplitterRow" Height="0"/><RowDefinition x:Name="BrowserDevRow" Height="0"/></Grid.RowDefinitions><TabControl x:Name="BrowserTabs" Grid.Row="0" SelectionChanged="BrowserTabs_SelectionChanged"/><GridSplitter x:Name="BrowserDevSplitter" Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#344258" Visibility="Collapsed"/><Grid x:Name="BrowserDevPanel" Grid.Row="2" Background="#0C1422" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Background="#172033"><Button DockPanel.Dock="Right" Content="×" ToolTip="Închide instrumentele" Width="28" Click="BrowserDevTools_Click"/><Button DockPanel.Dock="Right" Content="DevTools complet" ToolTip="Deschide instrumentele complete într-o fereastră" Click="BrowserFullDevTools_Click"/><TextBlock Text="DEVTOOLS" Foreground="#C7DCF7" Margin="10,6"/></DockPanel><TabControl x:Name="BrowserDevTabs" Grid.Row="1" SelectionChanged="BrowserDevTabs_SelectionChanged"><TabItem Header="Consolă"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="BrowserConsoleText" Grid.Row="0" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0C1422" Foreground="#DCE7F7" BorderThickness="0" Padding="8"/><DockPanel Grid.Row="1"><Button DockPanel.Dock="Right" Content="Execută" Click="BrowserConsoleExecute_Click"/><TextBox x:Name="BrowserConsoleInput" KeyDown="BrowserConsoleInput_KeyDown" FontFamily="Consolas" ToolTip="Expresie JavaScript"/></DockPanel></Grid></TabItem><TabItem Header="Elemente"><TextBox x:Name="BrowserElementsText" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#0C1422" Foreground="#DCE7F7" BorderThickness="0" Padding="8"/></TabItem><TabItem Header="Rețea"><TextBox x:Name="BrowserNetworkText" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0C1422" Foreground="#DCE7F7" BorderThickness="0" Padding="8"/></TabItem></TabControl></Grid></Grid><TextBlock x:Name="BrowserStatusText" Grid.Row="2" Text="Pregătit" Foreground="#9FB3D0" Background="#172033" Padding="8,3"/></Grid></TabItem>
    </TabControl>
   </Grid>
    <GridSplitter x:Name="RightToolSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#26354A"/>
    <Grid x:Name="RightToolHost" Grid.Column="4" Background="{StaticResource Surface}"><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="220"/><RowDefinition Height="5"/><RowDefinition Height="225" MinHeight="170"/><RowDefinition Height="5"/><RowDefinition Height="260" MinHeight="190"/></Grid.RowDefinitions>
     <DockPanel x:Name="AssistantPanel" Grid.Row="0">
     <StackPanel DockPanel.Dock="Top" Margin="12,11,12,5"><TextBlock Text="ASISTENT" Style="{StaticResource SectionTitle}"/><TextBlock Text="Cere modificări, apoi revino din Istoric" FontSize="11" Foreground="#788DA9" Margin="0,2,0,3"/><TextBlock x:Name="CreditBalanceText" Text="AI: 0 cereri · 0 tokenuri · sold real indisponibil" Foreground="#C7DCF7" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,3"/><StackPanel Orientation="Horizontal"><TextBlock Text="Buget tokenuri" Foreground="#9FB3D0" VerticalAlignment="Center" FontSize="11"/><TextBox x:Name="CreditBudgetBox" Width="90" Margin="6,0,0,0" ToolTip="Buget opțional în tokenuri; nu este soldul de facturare al furnizorului" LostFocus="CreditBudget_LostFocus"/></StackPanel></StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="9,3,9,9"><TextBox x:Name="PromptBox" Height="76" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" ToolTip="Descrie ce vrei să creezi sau modifici"/><StackPanel Orientation="Horizontal"><Button x:Name="DictationButton" Content="🎙 Dictează" Click="Dictation_Click"/><Button Content="Trimite către agent" Click="SendPrompt_Click" Style="{StaticResource PrimaryButton}"/></StackPanel><Button Content="Repară eroarea de build cu AI" Click="RepairBuild_Click" HorizontalAlignment="Stretch"/></StackPanel>
     <TextBox x:Name="ChatLog" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#101827" BorderBrush="#344258" BorderThickness="1" Margin="9,0,9,4"/>
    </DockPanel>
    <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#344258"/>
    <ScrollViewer x:Name="PropertiesPanel" Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="InspectorHost" Margin="12,9"/></ScrollViewer>
    <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="#344258"/>
    <ScrollViewer x:Name="DataPanel" Grid.Row="4" VerticalScrollBarVisibility="Auto"><StackPanel Margin="12,9"><TextBlock Text="DATE ȘI SETĂRI" Style="{StaticResource SectionTitle}"/><TextBlock Text="Bază SQLite din proiect" Style="{StaticResource FieldTitle}"/><TextBox x:Name="ConnectionBox"/><StackPanel Orientation="Horizontal"><Button Content="Alege bază" Click="ChooseDatabase_Click"/><Button Content="Explorează" Click="ExploreDatabase_Click"/></StackPanel><ComboBox x:Name="DatabaseTablesBox"/><Button Content="Leagă tabelul la DataGrid" Click="BindTable_Click" HorizontalAlignment="Stretch"/><Separator Margin="0,8" Background="#344258"/><TextBlock Text="MOD AI" Style="{StaticResource SectionTitle}"/><ComboBox x:Name="ProviderBox" SelectionChanged="ProviderBox_SelectionChanged"><ComboBoxItem Content="Fără AI"/><ComboBoxItem Content="OpenAI"/><ComboBoxItem Content="Gemini"/></ComboBox><TextBlock Text="Editorul și compilarea funcționează fără cheie." TextWrapping="Wrap" Foreground="#8FA4C0" FontSize="11"/><TextBlock Text="Model API" Style="{StaticResource FieldTitle}"/><TextBox x:Name="ModelBox"/><TextBlock Text="Cheie API" Style="{StaticResource FieldTitle}"/><PasswordBox x:Name="ApiKeyBox" Background="#101827" Foreground="#E5EAF2" BorderBrush="#3A4B64" Padding="7,5"/><Button x:Name="SaveKeyButton" Content="Salvează cheia local" Click="SaveKey_Click" HorizontalAlignment="Stretch"/></StackPanel></ScrollViewer>
   </Grid>
   <Canvas x:Name="ToolCanvas" Grid.ColumnSpan="5" Panel.ZIndex="10" Background="{x:Null}"/>
  </Grid>
 </DockPanel>
